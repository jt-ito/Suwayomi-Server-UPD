@import suwayomi.tachidesk.i18n.MR
@import suwayomi.tachidesk.server.generated.BuildConfig

@param locale: java.util.Locale
@param error: String

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>${MR.strings.login_label_title.localized(locale)}</title>
    <style>
        * {
            box-sizing: border-box;
        }
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
        }
        body {
            display: flex;
            flex-direction: column;
            background-color: rgb(12, 16, 33);
            font-family: "Roboto","Helvetica","Arial",sans-serif;
            font-weight: 400;
            letter-spacing: 0em;
        }
        button[disabled], input[disabled] {
            cursor: not-allowed;
        }
        header {
            background-color: rgb(34, 38, 53);
            box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 4px -1px, rgba(0, 0, 0, 0.14) 0px 4px 5px 0px, rgba(0, 0, 0, 0.12) 0px 1px 10px 0px;
            color: #fff;
            padding: 8px 32px;
        }
        header h1, header p {
            margin: 0;
        }
        footer {
            color: #fff;
            padding: 8px;
        }
        footer p {
            margin: 0;
            font-size: 0.7rem;
        }
        main {
            height: 100%;
        }
        main {
            position: relative;
            padding-top: 24px;
        }
        form {
            margin: 8px;
            padding: 8px 24px;
            border-radius: 8px;
            border: 1px solid rgb(12, 16, 33);
            background-color: rgb(6, 8, 16);
            color: white;
        }
        .error {
            margin: 8px;
            padding: 8px 16px;
            border-radius: 8px;
            border: 1px solid #b71c1c;
            background-color: #c62828;
            color: white;
        }
        .error:empty {
            display: none;
        }
        form label {
            cursor: pointer;
        }
        form button {
            all: unset;
            padding: 8px;
            line-height: 1.75;
            text-align: center;
            min-width: 64px;
            border-radius: 4px;
            padding: 6px 8px;
            color: rgb(91, 116, 239);
            text-transform: uppercase;
            letter-spacing: 0.02857em;
        }
        form button:not([disabled]) {
            cursor: pointer;
        }
        form button:not([disabled]):hover {
            background-color: rgba(91, 116, 239, 0.08);
        }
        form input {
            all: unset;
            border-radius: 4px;
            border: 1px solid rgba(255, 255, 255, 0.23);
            padding: 6px 12px;
            width: auto;
            min-width: 0;
        }
        form input:hover {
            border-color: white;
        }
        form input:focus {
            border-color: rgb(91, 116, 239);
        }
        form .controls {
            display: grid;
            align-items: center;
            grid-template-columns: 1fr;
        }
        form .controls > :nth-child(even):not(:last-child) {
            margin-bottom: 6px;
        }
        form .submit {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 24px;
        }

        @media (min-width: 500px) {
            form {
                width: 100%;
                max-width: 450px;
                margin: 8px auto;
            }
            .error {
                width: 100%;
                max-width: 450px;
                margin: 8px auto;
            }
            form .controls {
                grid-template-columns: auto 1fr;
                column-gap: 16px;
                row-gap: 6px;
            }
            form .controls > :nth-child(even):not(:last-child) {
                margin-bottom: 0px;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>tsundoku</h1>
    </header>
    <main>
        <div class="error">${error}</div>
        <form method="POST">
            <h2>Login</h2>
            <div class="controls">
                <label for="user">${MR.strings.login_label_username.localized(locale)}:</label>
                    <input type="text" name="user" id="user" required pattern="^[a-zA-Z0-9._-]{3,32}$" minlength="3" maxlength="32" title="3-32 characters: letters, numbers, underscores, dots, or hyphens" autocomplete="username" placeholder="${MR.strings.login_placeholder_username.localized(locale)}"/>
                    <label for="pass">${MR.strings.login_label_password.localized(locale)}:</label>
                    <input type="password" name="pass" id="pass" required minlength="4" maxlength="128" autocomplete="current-password" placeholder="${MR.strings.login_placeholder_password.localized(locale)}"/>
            </div>
            <div class="submit">
                <button type="submit">${MR.strings.login_label_login.localized(locale)}</button>
            </div>
        </form>
    </main>
    <footer>
        <p>tsundoku: ${MR.strings.label_version.localized(locale, BuildConfig.VERSION)}</p>
    </footer>
    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            e.preventDefault();
            var errEl = document.querySelector('.error');
            if (errEl) errEl.style.display = 'none';
            var u = document.getElementById('user').value.trim();
            var p = document.getElementById('pass').value;

            var userRegex = /^[a-zA-Z0-9._-]{3,32}$/;
            if (!u || u.length < 3 || u.length > 32 || !userRegex.test(u) || /[<>"'/\\`]/.test(u)) {
                if (errEl) {
                    errEl.textContent = 'Username must be between 3 and 32 characters (letters, numbers, underscores, dots, or hyphens only).';
                    errEl.style.display = 'block';
                }
                return;
            }
            if (!p || p.length < 4 || p.length > 128) {
                if (errEl) {
                    errEl.textContent = 'Password must be between 4 and 128 characters.';
                    errEl.style.display = 'block';
                }
                return;
            }

            var btn = document.querySelector('button[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Authenticating...';
            }
            fetch('./api/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    query: 'mutation($input: LoginInput!) { login(input: $input) { accessToken refreshToken } }',
                    variables: { input: { username: u, password: p } }
                })
            }).then(function(res) {
                return res.json();
            }).then(function(data) {
                if (data.errors && data.errors.length) {
                    throw new Error(data.errors[0].message || 'Invalid username or password');
                }
                if (data.data && data.data.login && data.data.login.accessToken) {
                    var token = data.data.login.accessToken;
                    localStorage.setItem('suwayomi-server-token', token);
                    localStorage.removeItem('suwayomi-signed-out');
                    document.cookie = 'suwayomi-server-token=' + token + '; path=/; max-age=2592000; SameSite=Lax';
                    var params = new URLSearchParams(window.location.search);
                    var redirect = params.get('redirect') || './';
                    // only same-site paths (not javascript: URLs, //host or backslash tricks)
                    if (redirect.charAt(0) !== '/' || redirect.charAt(1) === '/' || redirect.charAt(1) === '\\') {
                        redirect = './';
                    }
                    window.location.href = redirect;
                } else {
                    throw new Error('Invalid username or password');
                }
            }).catch(function(err) {
                if (errEl) {
                    var raw = (err && err.message) || '';
                    var low = raw.toLowerCase();
                    if (low.indexOf('incorrect') !== -1 || low.indexOf('password') !== -1 || low.indexOf('credential') !== -1 || raw.indexOf('graphql.execution') !== -1) {
                        errEl.textContent = 'Incorrect username or password';
                    } else {
                        errEl.textContent = raw || 'Invalid username or password';
                    }
                    errEl.style.display = 'block';
                }
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Log In';
                }
            });
        });
    </script>
</body>
</html>

